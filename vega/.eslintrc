{
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "@react-native",
    "eslint:recommended"
  ],
  "overrides": [
    {
      "files": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": "./tsconfig.json"
      }
    }
  ],
  "ignorePatterns": [
    "babel.config.js",
    "metro.config.js",
    "jest.config.json",
    "package-lock.json"
  ]
}
